{"abstract":[{"text":"Label untracked directories as untracked, without scanning for ignored","type":"text"},{"text":" ","type":"text"},{"text":"files.","type":"text"}],"sections":[],"kind":"symbol","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftlibgit2\/gitdiffoptiont\/gitdiffenablefastuntrackeddirs"]}],"hierarchy":{"paths":[["doc:\/\/SwiftLibgit2\/documentation\/SwiftLibgit2","doc:\/\/SwiftLibgit2\/documentation\/SwiftLibgit2\/GitDiffOptionT"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiftLibgit2\/documentation\/SwiftLibgit2\/GitDiffOptionT\/gitDiffEnableFastUntrackedDirs"},"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"gitDiffEnableFastUntrackedDirs","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:12SwiftLibgit214GitDiffOptionTV","text":"GitDiffOptionT","identifier":"doc:\/\/SwiftLibgit2\/documentation\/SwiftLibgit2\/GitDiffOptionT","kind":"typeIdentifier"}]}],"kind":"declarations"},{"content":[{"type":"heading","level":2,"text":"Discussion","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"text":"The normal Git behavior is to scan the entire content of an untracked","type":"text"},{"text":" ","type":"text"},{"text":"directory. If all the content of an untracked directory is ignored,","type":"text"},{"text":" ","type":"text"},{"text":"then the directory is labeled as ignored. If any of the content is not","type":"text"},{"text":" ","type":"text"},{"text":"ignored, then the directory is labeled as untracked.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"This flag indicates that the scan should not be performed, and"},{"type":"text","text":" "},{"type":"text","text":"untracked directories should be immediately labeled as untracked."}]}],"kind":"content"}],"metadat