{"abstract":[{"type":"text","text":"Label untracked directories as untracked, without scanning for ignored"},{"type":"text","text":" "},{"type":"text","text":"files."}],"kind":"symbol","variants":[{"paths":["\/documentation\/swiftlibgit2\/gitdiffoptiont\/gitdiffenablefastuntrackeddirs"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"gitDiffEnableFastUntrackedDirs"},{"kind":"text","text":": "},{"preciseIdentifier":"s:12SwiftLibgit214GitDiffOptionTV","kind":"typeIdentifier","text":"GitDiffOptionT"}],"symbolKind":"property","title":"gitDiffEnableFastUntrackedDirs","role":"symbol","modules":[{"name":"swift-libgit2"}],"externalID":"s:12SwiftLibgit214GitDiffOptionTV03gitD23EnableFastUntrackedDirsACvpZ","roleHeading":"Type Property"},"sections":[],"hierarchy":{"paths":[["doc:\/\/SwiftLibgit2\/documentation\/SwiftLibgit2","doc:\/\/SwiftLibgit2\/documentation\/SwiftLibgit2\/GitDiffOptionT"]]},"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"gitDiffEnableFastUntrackedDirs"},{"kind":"text","text":": "},{"preciseIdentifier":"s:12SwiftLibgit214GitDiffOptionTV","kind":"typeIdentifier","text":"GitDiffOptionT","identifier":"doc:\/\/SwiftLibgit2\/documentation\/SwiftLibgit2\/GitDiffOptionT"}],"languages":["swift"],"platforms":["macOS"]}],"kind":"declarations"},{"kind":"content","content":[{"level":2,"anchor":"discussion","type":"heading","text":"Discussion"},{"inlineContent":[{"type":"text","text":"The normal Git behavior is to scan the entire content of an untracked"},{"type":"text","text":" "},{"type":"text","text":"directory. If all the content of an untracked directory is ignored,"},{"type":"text","text":" "},{"type":"text","text":"then the directory is label