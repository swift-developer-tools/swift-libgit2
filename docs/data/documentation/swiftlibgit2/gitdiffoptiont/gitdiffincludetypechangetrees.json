{"abstract":[{"text":"Use type change deltas for blob-to-tree type changes.","type":"text"}],"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"gitDiffIncludeTypeChangeTrees"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:12SwiftLibgit214GitDiffOptionTV","identifier":"doc:\/\/SwiftLibgit2\/documentation\/SwiftLibgit2\/GitDiffOptionT","text":"GitDiffOptionT"}]}],"kind":"declarations"},{"content":[{"text":"Discussion","type":"heading","anchor":"Discussion","level":2},{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/SwiftLibgit2\/documentation\/SwiftLibgit2\/GitDiffOptionT\/gitDiffIncludeTypeChange","isActive":true},{"type":"text","text":" uses type change deltas in the diff,"},{"type":"text","text":" "},{"type":"text","text":"instead of add\/delete pairs. However, blob-to-tree type changes are"},{"type":"text","text":" "},{"type":"text","text":"generally still represented as a deleted delta. This flag tries to"},{"type":"text","text":" "},{"type":"text","text":"correctly label these transitions as type changes with the new file’s"},{"type":"text","text":" "},{"type":"text","text":"mode set to "},{"type":"codeVoice","code":"tree"},{"type":"text","text":". The tree SHA will not be available."}]}],"kind":"content"}],"metadata":{"fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"gitDiffIncludeTypeChangeTrees"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:12SwiftLibgit214GitDiffOptionTV","text":"GitDiffOptionT"}],"roleHeading":"Type Property","symbolKind":"property","role":"symbol","title":"gitDiffIncludeTypeChangeTrees","externalID":"s:12SwiftLibgit214GitDiffOptionTV03gitD22Inclu