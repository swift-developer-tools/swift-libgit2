"}],"title":"similarity","role":"symbol","identifier":"doc:\/\/SwiftLibgit2\/documentation\/SwiftLibgit2\/GitDiffDelta\/similarity","type":"topic","url":"\/documentation\/swiftlibgit2\/gitdiffdelta\/similarity","abstract":[{"type":"text","text":"The similarity threshold (0 - 100) of the item for"},{"type":"text","text":" "},{"identifier":"doc:\/\/SwiftLibgit2\/documentation\/SwiftLibgit2\/GitDeltaT\/gitDeltaRenamed","isActive":true,"type":"reference"},{"type":"text","text":" and "},{"identifier":"doc:\/\/SwiftLibgit2\/documentation\/SwiftLibgit2\/GitDeltaT\/gitDeltaCopied","isActive":true,"type":"reference"},{"type":"text","text":" changes."}]},"doc://SwiftLibgit2/documentation/SwiftLibgit2/GitDiffDelta/flags":{"title":"flags","kind":"symbol","abstract":[{"type":"text","text":"The flags for the delta object and the file objects on each side of"},{"type":"text","text":" "},{"type":"text","text":"the delta."}],"type":"topic","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"flags"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"GitDiffFlagT","preciseIdentifier":"s:12SwiftLibgit212GitDiffFlagTV"}],"role":"symbol","url":"\/documentation\/swiftlibgit2\/gitdiffdelta\/flags","identifier":"doc:\/\/SwiftLibgit2\/documentation\/SwiftLibgit2\/GitDiffDelta\/flags"},"doc://SwiftLibgit2/documentation/SwiftLibgit2/gitDiffFindSimilar(diff:options:)":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"gitDiffFindSimilar"},{"text":"(","kind":"text"},{"text":"diff","kind":"externalParam"},{"kind":"text","text":": "},{"preciseIdentifier":"s:s13OpaquePointerV","kind":"typeIdentifier","text":"OpaquePointer"},{"kind":"text","text":", "},{"kind":"externalParam","text":"options"},{"kind":"text","text":": "},{"preciseIdentifier":"s:12SwiftLibgit218GitDiffFindOptionsV","kind":"typeIdentifier","text":"GitDiffFindOptions"},{"kind":"text","text":"?) -> "},{"preciseIdentifier":"s:12SwiftLibgit212GitErrorCodeO","kind":"typeIdentifier","text":"GitErrorCode"}],"abstract":[{"text":"Transforms a diff, marking file renames or copies, and breaking modified","type":"text"},{"text":" ","type":"text"},{"text":"files into add\/remove pairs if requested.","type":"text"}],"role":"symbol","url":"\/documentation\/swiftlibgit2\/gitdifffindsimilar(diff:options:)","type":"topic","kind":"symbol","identifier":"doc:\/\/SwiftLibgit2\/documentation\/SwiftLibgit2\/gitDiffFindSimilar(diff:options:)","title":"gitDiffFindSimilar(diff:options:)"},"doc://SwiftLibgit2/documentation/SwiftLibgit2/GitDiffFlagT/gitDiffFlagNotBinary":{"title":"gitDiffFlagNotBinary","kind":"symbol","abstract":[{"type":"text","text":"The files are treated as text data."}],"type":"topic","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"gitDiffFlagNotBinary"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"GitDiffFlagT","preciseIdentifier":"s:12SwiftLibgit212GitDiffFlagTV"}],"role":"symbol","url":"\/documentation\/swiftlibgit2\/gitdiffflagt\/gitdiffflagnotbinary","identifier":"doc:\/\/SwiftLibgit2\/documentation\/SwiftLibgit2\/GitDiffFlagT\/gitDiffFlagNotBinary"},"doc://SwiftLibgit2/documentation/SwiftLibgit2/GitDiffBinaryFile":{"abstract":[{"type":"text","text":"The contents of one of the files in a binary diff."}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"GitDiffBinaryFile"}],"navigatorTitle":[{"kind":"identifier","text":"GitDiffBinaryFile"}],"title":"GitDiffBinaryFile","role":"symbol","identifier":"doc:\/\/SwiftLibgit2\/documentation\/SwiftLibgit2\/GitDiffBinaryFile","type":"topic","url":"\/documentation\/swiftlibgit2\/gitdiffbinaryfile","kind":"symbol"},"doc://SwiftLibgit2/documentation/SwiftLibgit2/GitDiffDelta":{"url":"\/documentation\/swiftlibgit2\/gitdiffdelta","title":"GitDiffDelta","fragments":[{"kind":