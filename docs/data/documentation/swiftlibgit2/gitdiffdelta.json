{"hierarchy":{"paths":[["doc:\/\/SwiftLibgit2\/documentation\/SwiftLibgit2"]]},"topicSections":[{"title":"Instance Properties","generated":true,"identifiers":["doc:\/\/SwiftLibgit2\/documentation\/SwiftLibgit2\/GitDiffDelta\/flags","doc:\/\/SwiftLibgit2\/documentation\/SwiftLibgit2\/GitDiffDelta\/nFiles","doc:\/\/SwiftLibgit2\/documentation\/SwiftLibgit2\/GitDiffDelta\/newFile","doc:\/\/SwiftLibgit2\/documentation\/SwiftLibgit2\/GitDiffDelta\/oldFile","doc:\/\/SwiftLibgit2\/documentation\/SwiftLibgit2\/GitDiffDelta\/similarity","doc:\/\/SwiftLibgit2\/documentation\/SwiftLibgit2\/GitDiffDelta\/status"],"anchor":"Instance-Properties"}],"relationshipsSections":[{"kind":"relationships","title":"Conforms To","identifiers":["doc:\/\/SwiftLibgit2\/s8SendableP","doc:\/\/SwiftLibgit2\/s16SendableMetatypeP"],"type":"conformsTo"}],"seeAlsoSections":[{"generated":true,"identifiers":["doc:\/\/SwiftLibgit2\/documentation\/SwiftLibgit2\/GitDiffFile","doc:\/\/SwiftLibgit2\/documentation\/SwiftLibgit2\/GitDiffOptions","doc:\/\/SwiftLibgit2\/documentation\/SwiftLibgit2\/GitDiffBinaryFile","doc:\/\/SwiftLibgit2\/documentation\/SwiftLibgit2\/GitDiffBinary","doc:\/\/SwiftLibgit2\/documentation\/SwiftLibgit2\/GitDiffHunk","doc:\/\/SwiftLibgit2\/documentation\/SwiftLibgit2\/GitDiffLine","doc:\/\/SwiftLibgit2\/documentation\/SwiftLibgit2\/GitDiffSimilarityMetric","doc:\/\/SwiftLibgit2\/documentation\/SwiftLibgit2\/GitDiffFindOptions","doc:\/\/SwiftLibgit2\/documentation\/SwiftLibgit2\/GitDiffParseOptions","doc:\/\/SwiftLibgit2\/documentation\/SwiftLibgit2\/GitDiffPatchIDOptions"],"title":"Structs","anchor":"Structs"}],"identifier":{"url":"doc:\/\/SwiftLibgit2\/documentation\/SwiftLibgit2\/GitDiffDelta","interfaceLanguage":"swift"},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"GitDiffDelta","kind":"identifier"}],"languages":["swift"],"platforms":["macOS"]}]},{"content":[{"anchor":"overview","type":"heading","text":"Overview","level":2},{"inlineContent":[{"text":"A delta is a file pair with old and new versions. The old version may be","type":"text"},{"type":"text","text":" "},{"text":"absent if the file was just created and the new version may be absent if","type":"text"},{"text":" ","type":"text"},{"text":"the file was deleted. A diff is mostly just a list of deltas.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"When iterating over a diff, this will be passed to most callbacks and the"},{"type":"text","text":" "},{"type":"text","text":"file contents may be used to understand exactly what has changed."}],"type":"paragraph"},{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/SwiftLibgit2\/documentation\/SwiftLibgit2\/GitDiffDelta\/oldFile","type":"reference"},{"text":" represents the “from” side of the diff and","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiftLibgit2\/documentation\/SwiftLibgit2\/GitDiffDelta\/newFile"},{"text":" represents to “to” side of the diff. What those","type":"text"},{"type":"text","text":" "},{"text":"means depend on the function that was used to generate the diff and is","type":"text"},{"type":"text","text":" "},{"text":"explained below. The ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiftLibgit2\/documentation\/SwiftLibgit2\/GitDiffOptionT\/gitDiffReverse"},{"text":" flag may be used","type":"text"},{"type":"text","text":" "},{"text":"to reverse this relationship.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Although the two sides of the delta are named ","type":"text"},{"identifier":"doc:\/\/SwiftLibgit2\/documentation\/SwiftLibgit2\/GitDiffDelta\/oldFile","isActive":true,"type":"reference"},{"type":"text","text":" "},{"type":"text","text":"and "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiftLibgit2\/documentation\/SwiftLibgit2\/GitDiffDelta\/newFile"},{"type":"text","text":", they actually may correspond to entries that"},{"type":"text","text":" "},{"type":"text","text":"represent a file, a symbolic link, a submodule commit ID, or even a tree"},{"type":"text","text":" "},{"type":"text","text":"(when tracking type changes or ignored or untracked directories)."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Under some circumstances, in the name of efficiency, not all properties"},{"type":"text","text":" "},{"type":"text","text":"will be filled in, but generally as much as possible will be filled in."},{"type":"text","text":" "},{"type":"text","text":"For example, "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiftLibgit2\/documentation\/SwiftLibgit2\/GitDiffDelta\/flags"},{"type":"text","text":" may not have either the"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/SwiftLibgit2\/documentation\/SwiftLibgit2\/GitDiffFlagT\/gitDiffFlagBinary","isActive":true},{"type":"text","text":" or the"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/SwiftLibgit2\/documentation\/SwiftLibgit2\/GitDiffFlagT\/gitDiffFlagNotBinary","isActive":true},{"type":"text","text":" flag set to avoid examining file"},{"type":"text","text":" "},{"type":"text","text":"contents when no hunk and\/or line callbacks are passed in. In this case,"},{"type":"text","text":" "},{"type":"text","text":"the diff iteration process will use the Git attributes for those files."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/SwiftLibgit2\/documentation\/SwiftLibgit2\/GitDiffDelta\/similarity","type":"reference","isActive":true},{"text":" will be zero unless","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/SwiftLibgit2\/documentation\/SwiftLibgit2\/gitDiffFindSimilar(diff:options:)","type":"reference","isActive":true},{"text":" is called, which performs a","type":"text"},{"text":" ","type":"text"},{"text":"similarity analysis of files in the diff. That function may be used to","type":"text"},{"text":" ","type":"text"},{"text":"perform rename and copy detection, and to split heavily modified files","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"into add\/delete pairs. After that call, deltas with a status of"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/SwiftLibgit2\/documentation\/SwiftLibgit2\/GitDeltaT\/gitDeltaRenamed","isActive":true},{"text":" or ","type":"text"},{"identifier":"doc:\/\/SwiftLibgit2\/documentation\/SwiftLibgit2\/GitDeltaT\/gitDeltaCopied","type":"reference","isActive":true},{"type":"text","text":" will have"},{"type":"text","text":" "},{"type":"text","text":"a similarity score between 0 and 100 indicating the similarity between"},{"type":"text","text":" "},{"type":"text","text":"the old version and the new version."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"If "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiftLibgit2\/documentation\/SwiftLibgit2\/gitDiffFindSimilar(diff:options:)"},{"type":"text","text":" is used to find heavily modified"},{"type":"text","text":" "},{"type":"text","text":"files to break, but not to actually break the records, then"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiftLibgit2\/documentation\/SwiftLibgit2\/GitDeltaT\/gitDeltaModified"},{"type":"text","text":" records may have a non-zero similarity score"},{"type":"text","text":" "},{"type":"text","text":"if the self-similarity is below the split threshold. To display this value"},{"type":"text","text":" "},{"type":"text","text":"like core Git, invert the score by subtracting it from 100."}]},{"type":"heading","text":"C Equivalent","anchor":"C-Equivalent","level":2},{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"https:\/\/libgit2.org\/docs\/reference\/main\/diff\/git_diff_delta.html","isActive":true}]}],"kind":"content"}],"variants":[{"paths":["\/documentation\/swiftl