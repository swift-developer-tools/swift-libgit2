{"abstract":[{"type":"text","text":"Do not break rewrites unless they contribute to a rename."}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"gitDiffBreakRewritesForRenamesOnly"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:12SwiftLibgit212GitDiffFindTV","identifier":"doc:\/\/SwiftLibgit2\/documentation\/SwiftLibgit2\/GitDiffFindT","text":"GitDiffFindT"}],"platforms":["macOS"],"languages":["swift"]}]},{"kind":"content","content":[{"level":2,"type":"heading","text":"Discussion","anchor":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Normally, the "},{"type":"reference","identifier":"doc:\/\/SwiftLibgit2\/documentation\/SwiftLibgit2\/GitDiffFindT\/gitDiffFindAndBreakRewrites","isActive":true},{"type":"text","text":" flag will measure the"},{"type":"text","text":" "},{"type":"text","text":"self-similarity of modified files, and split the ones that have changed"},{"type":"text","text":" "},{"type":"text","text":"significantly into an add\/delete pair. Then, the sides of that pair"},{"type":"text","text":" "},{"type":"text","text":"will be considered candidates for rename and copy detection."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"If this flag is enabled, and the split pair is not used for an actual"},{"type":"text","text":" "},{"type":"text","text":"rename or copy, then the modified record will be restored to a regular"},{"type":"text","text":" "},{"type":"text","text":"modified record instead of being split."}]}]}],"metadata":{"fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"gitDiffBreakRewritesForRenamesOnly"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:12SwiftLibgit212GitDiffFindTV","text":"GitDiffFindT"}],"roleHeading":"Type Property","title":"gitDiffBreakRewritesForRenamesOnly","symbolKind":"property","role":"symbol","externalID":"s:12SwiftLibgit212GitDiffFindTV03gitD27BreakRewritesForRenamesOnlyACvpZ","modules":[{"name":"swift-libgit2"}]},"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiftLibgit2\/documentation\/SwiftLibgit2\/GitDiffFindT\/gitDiffBreakRewritesForRenamesOnly"},"hierarchy":{"paths":[["doc:\/\/SwiftLibgit2\/documentation\/SwiftLibgit2","doc:\/\/SwiftLibgit2\/documentation\/SwiftLibgit2\/GitDiffFindT"]]},"variants":[{"paths":["\/documentation\/swiftlibgit2\/gitdifffindt\/gitdiffbreakrewritesforrenamesonly"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"patch":0,"minor":3,"major":0},"kind":"symbol","references":{"doc://SwiftLibgit2/documentation/SwiftLibgit2/GitDiffFindT/gitDiffFindAndBreakRewrites":{"kind":"symbol","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"gitDiffFindAndBreakRewrites"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"GitDiffFindT","preciseIdentifier":"s:12SwiftLibgit212GitDiffFindTV"}],"title":"gitDiffFindAndBreakRewrites","role":"symbol","identifier":"doc:\/\/SwiftLibgit2\/documentation\/SwiftLibgit2\/GitDiffFindT\/gitDiffFindAndBreakRewrites","type":"topic","url":"\/documentation\/swiftlibgit2\/gitdifffindt\/gitdifffindandbreakrewrites","abstract":[{"type":"text","text":"Mark rewrites for splitting, and break them into add\/delete pairs."}]},"doc://SwiftLibgit2/documentation/SwiftLibgit2":{"title":"swift-libgit2","kind":"symbol","abstract":[{"type":"text","text":"Direct Swift bindings to libgit2."}],"type":"topic","role":"collection","url":"\/documentation\/swiftlibgit2","identifier":"doc:\/\/SwiftLibgit2\/documentation\/SwiftLibgit2"},"doc://SwiftLibgit2/documentation/SwiftLibgit2/GitDiffFindT/gitDiffBreakRewritesForRenam