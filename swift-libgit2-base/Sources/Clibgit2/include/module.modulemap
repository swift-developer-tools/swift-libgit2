module CLibgit2
{
    // `git2.h` includes all the necessary headers, excluding the deprecated
    // ones. Using an `umbrella header` would cause a warning about CLibgit2
    // missing the deprecated `git2/credential_helpers.h` header.
    header "git2.h"
    
    // Using an `umbrella header` would cause a warning about CLibgit2 missing
    // the deprecated `git2/sys/cred.h` header.
    header "git2/sys/alloc.h"
    header "git2/sys/commit.h"
    header "git2/sys/commit_graph.h"
    header "git2/sys/config.h"
    header "git2/sys/credential.h"
    header "git2/sys/diff.h"
    header "git2/sys/email.h"
    header "git2/sys/errors.h"
    header "git2/sys/filter.h"
    header "git2/sys/hashsig.h"
    header "git2/sys/index.h"
    header "git2/sys/mempack.h"
    header "git2/sys/merge.h"
    header "git2/sys/midx.h"
    header "git2/sys/odb_backend.h"
    header "git2/sys/openssl.h"
    header "git2/sys/path.h"
    header "git2/sys/refdb_backend.h"
    header "git2/sys/refs.h"
    header "git2/sys/remote.h"
    header "git2/sys/repository.h"
    header "git2/sys/stream.h"
    header "git2/sys/transport.h"
    
    export *
    link "libgit2"
    link "libssh2"
    link "libssl"
    link "libcrypto"
    link "z"
    link "iconv"
    link "framework Security"
    link "framework CoreFoundation"
}
